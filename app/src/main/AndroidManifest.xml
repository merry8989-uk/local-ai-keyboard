<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      INTERNET is used ONLY by the in-app downloader for model and language
      packs, which run when you explicitly tap Download. The keyboard itself
      never sends what you type anywhere: no telemetry, no accounts, no cloud.
      The app stores its state in app-private files on the device.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAiKeyboard">

        <!-- The keyboard itself -->
        <service
            android:name=".ime.LocalAiInputMethodService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Settings hub (also the launcher entry point) -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.ThemeActivity"
            android:exported="false"
            android:label="@string/theme_title" />

        <activity
            android:name=".settings.LanguagesActivity"
            android:exported="false"
            android:label="@string/languages_title" />

        <activity
            android:name=".settings.KeyboardSettingsActivity"
            android:exported="false"
            android:label="@string/keyboard_title" />

        <activity
            android:name=".settings.DictionaryActivity"
            android:exported="false"
            android:label="@string/dictionary_title" />

        <activity
            android:name=".settings.StickerActivity"
            android:exported="false"
            android:label="@string/stickers_title" />

        <!-- Shares local sticker files with chat apps via content:// URIs -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
